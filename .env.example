# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/ubuntu_terra

# --- Copernicus Data Space Ecosystem / Sentinel Hub ---
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# --- Weather (Open-Meteo needs no key; NASA POWER needs no key either) ---
# No keys required for either weather source. Left here for documentation/clarity.

# --- App ---
DEMO_LOGIN_USERNAME=demo
DEMO_LOGIN_PASSWORD=change-me
