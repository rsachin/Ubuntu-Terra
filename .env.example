# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/ubuntu_terra

# --- Copernicus Data Space Ecosystem / Sentinel Hub ---
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# --- Weather (Open-Meteo needs no key; NASA POWER needs no key either) ---
# No keys required for either weather source. Left here for documentation/clarity.

# --- Twilio Sandbox (WhatsApp) ---
# Must match the Auth Token shown in the Twilio console for the sandbox exactly.
# It is used to verify the X-Twilio-Signature header on inbound webhooks:
# a wrong token makes every genuine Twilio webhook return 403.
# If this is unset the webhook fails closed with a 500 (message not processed).
# Also set TWILIO_ACCOUNT_SID + TWILIO_WHATSAPP_NUMBER to send live alerts;
# without them, outbound delivery falls back to a recorded "simulated" send.
TWILIO_AUTH_TOKEN=

# --- CORS ---
# Comma-separated list of origins allowed to call the API from a browser.
# Must include the frontend's real origin(s). Once the frontend is deployed, add
# its URL here too (e.g. ALLOWED_ORIGINS=http://localhost:5173,https://my-app.onrender.com)
# — no code change needed. A wildcard is deliberately NOT used: any website could
# otherwise issue requests against the API from a farmer's browser. Requests from
# an origin missing from this list are blocked by the browser, so keep it accurate.
ALLOWED_ORIGINS=http://localhost:5173

# --- App Security ---
# Owner access is enforced with a per-owner opaque token sent as the
# X-Owner-Token header (see database/migrations/005_owner_tokens.sql and
# require_owner_token in backend/app/routers/fields.py). A new owner obtains a
# token once via POST /api/owners/register; the frontend stores it in
# localStorage.
#
# This is intentionally NOT a full authentication system: no passwords, no
# sessions, no token expiry, no rotation. It exists only to stop the trivial
# "type a different owner_id" gap. A production version would need
# password-based login, token expiry/rotation, and rate limiting on
# /api/owners/register to prevent owner_id enumeration/abuse.
#
# The two variables below are placeholders for a future real login screen and
# are not read by the API today.
DEMO_LOGIN_USERNAME=demo
DEMO_LOGIN_PASSWORD=change-me
